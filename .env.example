# Default /api works through the Vite proxy, including when using ngrok.
VITE_API_BASE_URL=/api
# Optional development/preview proxy target:
# API_PROXY_TARGET=http://127.0.0.1:8000
# To use a separately hosted API, set its URL ending in /api, then restart/rebuild.
# VITE_API_BASE_URL=https://api.example.by/api
